{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "paths": {
      "@ryze/shared": ["./packages/shared/src/index.ts"],
      "@ryze/shared/*": ["./packages/shared/src/*"]
    }
  },
  "include": [
    "tools",
    "apps/*/src/**/*.spec.ts",
    "apps/*/src/testing/**/*.ts",
    "packages/*/src/**/*.spec.ts",
    "packages/*/src/testing/**/*.ts",
    "vitest.config.ts"
  ]
}
