{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "paths": {
      "@ryze/core": ["./packages/core/src/index.ts"]
    }
  },
  "include": [
    "tools",
    "apps/*/src/**/*.spec.ts",
    "apps/*/testing/**/*.ts",
    "packages/*/src/**/*.spec.ts",
    "packages/*/testing/**/*.ts",
    "vitest.config.ts"
  ]
}
