{
  "name": "ryze-pipeline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r build && tsc -p tsconfig.json",
    "lint": "biome lint . && tsx tools/formatting/style.ts",
    "format": "biome check --write --formatter-enabled=false . && tsx tools/formatting/style.ts --write",
    "test": "vitest run",
    "migrate": "tsx packages/core/src/database/migrate.ts",
    "seed": "tsx tools/development/seed.ts",
    "demo": "tsx tools/development/demo.ts",
    "smoke": "tsx tools/development/smoke.ts",
    "shopify:check": "tsx tools/development/shopify.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@ryze/core": "workspace:*",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
