{
  "name": "@ryze/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && cp -R src/database/migrations dist/database/migrations && chmod +x dist/database/migrate.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "sanitize-html": "^2.18.1",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2"
  },
  "bin": {
    "ryze-migrate": "dist/database/migrate.js"
  }
}
