# Local Compose defaults. process.env is validated once at each service entrypoint.
POSTGRES_PORT=5432
DATABASE_URL=postgres://ryze:ryze@postgres:5432/ryze
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ryze
S3_ACCESS_KEY=ryze
S3_SECRET_KEY=ryze-secret-key
# Development key only. Generate a deployment key with: openssl rand -base64 32
SITE_TOKEN_KEY=s/+gZRCU8G6pRxjRigAlO0ro630XgAyXQkwg+3nML4Q=

# Providers default to mocks; Compose supplies their internal endpoints.
# To use real generation, uncomment these and supply your own keys.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=...
# IMAGE_PROVIDER=openai
# OPENAI_API_KEY=...

# Optional smoke-test destinations (pnpm smoke).
# WORDPRESS_URL=https://blog.example.com
# WORDPRESS_USER=editor
# WORDPRESS_APP_PASSWORD=...
