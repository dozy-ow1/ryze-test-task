# Local Compose defaults. process.env is validated once at each service entrypoint.
POSTGRES_PORT=5432
DATABASE_URL=postgres://ryze:ryze@postgres:5432/ryze
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ryze
S3_ACCESS_KEY=ryze
S3_SECRET_KEY=ryze-secret-key
# Development key only. Generate a deployment key with: openssl rand -base64 32
SITE_TOKEN_KEY=s/+gZRCU8G6pRxjRigAlO0ro630XgAyXQkwg+3nML4Q=

# Providers default to mocks; Compose supplies their internal endpoints.
# To use real generation, uncomment these and supply your own keys.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=...
# IMAGE_PROVIDER=openai
# OPENAI_API_KEY=...

# Shopify: pnpm shopify:check lists granted scopes and blogs without publishing.
# Required scopes: write_content, read_files, write_files.
# SHOPIFY_SHOP=your-store.myshopify.com
# SHOPIFY_CLIENT_ID=...
# SHOPIFY_CLIENT_SECRET=...
# SHOPIFY_BLOG_ID=gid://shopify/Blog/123456789

# Explicitly use the Shopify mock in local demos; live is the default.
# SHOPIFY_MODE=mock
