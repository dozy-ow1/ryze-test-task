# One env file for every service. Copy to .env (pnpm demo does it for you if .env is missing).
# These values run everything against the fake providers and fake platforms.

# Host port Compose publishes Postgres on (set 5433 if 5432 is taken on your machine).
POSTGRES_PORT=5432

DATABASE_URL=postgres://ryze:ryze@postgres:5432/ryze

S3_ENDPOINT=http://minio:9000
S3_BUCKET=ryze
S3_ACCESS_KEY=ryze
S3_SECRET_KEY=ryze-secret-key

# 32 bytes, base64. Demo key only: generate your own with `openssl rand -base64 32`.
SITE_TOKEN_KEY=s/+gZRCU8G6pRxjRigAlO0ro630XgAyXQkwg+3nML4Q=

# Worker. POOL, CONCURRENCY and LEASE_SECONDS are set per service in docker-compose.yml.
IMAGE_CONCURRENCY=4
MAX_ATTEMPTS=8
HTTP_TIMEOUT_MS=30000

# Fakes: default fault injection (sites can override it when they register on fake-platforms).
FAULT_RATE=0.15
FAULT_KINDS=429,500,timeout,slow,complete_then_drop

LOG_LEVEL=info

# Providers: fake (default) or the real services.
LLM_PROVIDER=fake
IMAGE_PROVIDER=fake
LLM_BASE_URL=http://fake-providers:8091
IMAGE_BASE_URL=http://fake-providers:8091
# The reconciler reads /_admin/inspect here to find stray drafts on the fake platforms.
FAKE_PLATFORMS_URL=http://fake-platforms:8092

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
# IMAGE_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_IMAGE_MODEL=gpt-image-1

# pnpm smoke only: one real site of each kind, registered through POST /sites.
# WORDPRESS_URL=https://blog.example.com
# WORDPRESS_USER=editor
# WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# SHOPIFY_STORE=my-store.myshopify.com
# SHOPIFY_ACCESS_TOKEN=shpat_...
# SHOPIFY_BLOG_ID=123
